@@ -8,5 +8,6 @@ def money(value: float | Decimal) -> float:
     return format_money(value)
 
 
-def calculate_total(items: list[CartItem]) -> float:
-    return money(sum((Decimal(str(item.product.price)) * item.quantity for item in items), Decimal(0)))
+def calculate_total(items: list[CartItem], discount_percent: int = 0) -> float:
+    subtotal = sum((Decimal(str(item.product.price)) * item.quantity for item in items), Decimal(0))
+    return money(subtotal * Decimal(100 - discount_percent) / Decimal(100))
